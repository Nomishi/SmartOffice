# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit .env
POSTGRES_DB=smartoffice
POSTGRES_USER=smartoffice
POSTGRES_PASSWORD=smartoffice

# Backend chạy trên host (mvn spring-boot:run)
# Nếu chạy backend trong Docker: docker-compose.yml đã tự cấu hình jdbc:postgresql://postgres:5432/smartoffice
DB_URL=jdbc:postgresql://localhost:5433/smartoffice
DB_USER=smartoffice
DB_PASSWORD=smartoffice

# MQTT
# Trên máy Windows nếu đã có mosquitto service chiếm 1883, map port host sang 1884
MOSQUITTO_PORT=1883
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=smartoffice-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# Chạy backend Docker kèm mock M1/M2 (dữ liệu giả realtime cho frontend):
# SPRING_PROFILES_ACTIVE=mock

# Server / CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth JWT & Passwords Seed
JWT_SECRET=smartoffice-super-secret-dev-jwt-key-minimum-256-bits-length-required-for-hs256!
ADMIN_PASSWORD=adminPassword123!
OPERATOR_PASSWORD=operatorPassword123!
VIEWER_PASSWORD=viewerPassword123!
