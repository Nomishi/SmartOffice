# Copy file này thành deployment/.env rồi đổi mật khẩu. KHÔNG commit .env.
# Full stack: deployment/docker-compose.yml

# --- PostgreSQL ---
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=doi-mat-khau-db

# --- Mosquitto: user:mật_khẩu, ngăn cách bằng dấu phẩy ---
# Không dùng dấu phẩy, dấu cách hoặc ký tự $ trong mật khẩu.
# Username = deviceId. `backend` là tài khoản Spring Boot.
MQTT_USERS=backend:doi-mat-khau-backend,office-env-01:doi-mat-khau-env01,office-ctrl-01:doi-mat-khau-ctrl01

# --- Backend Spring Boot ---
# Phải trùng mật khẩu user `backend` trong MQTT_USERS
BACKEND_MQTT_PASSWORD=doi-mat-khau-backend
# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=doi-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# true: seed admin/operator1/viewer1 (chỉ dev)
SEED_DEV_USERS=true
ADMIN_PASSWORD=adminPassword123!
OPERATOR_PASSWORD=operatorPassword123!
VIEWER_PASSWORD=viewerPassword123!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Còi buzzer1 ---
# Tự kêu ALARM khi có alert TEMP_HIGH/AIR_BAD/DOOR_LEFT_OPEN/ENERGY_WASTE
BUZZER_AUTO_ALERT_ENABLED=true
BUZZER_COOLDOWN_SECONDS=60

# --- Frontend Docker ---
# true: build bản demo dùng mock, không cần backend
FRONTEND_USE_MOCK=false

# --- AI (tùy chọn) ---
# Bật endpoint POST /api/ai/chat. Key chỉ nằm ở backend, không lộ ra frontend.
# Provider cloud (OpenAI/Groq...) cần AI_API_KEY; Ollama/LM Studio có thể để trống.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
# Ví dụ Ollama local: AI_BASE_URL=http://host.docker.internal:11434/v1, AI_MODEL=llama3.1
# Ví dụ Groq: AI_BASE_URL=https://api.groq.com/openai/v1

# --- Backend chạy local ngoài Docker (tùy chọn) ---
# DB_URL=jdbc:postgresql://localhost:5432/iot
# DB_USER=iot
# DB_PASSWORD=doi-mat-khau-db
# MQTT_BROKER_URL=tcp://localhost:1883
# MQTT_USERNAME=backend
# MQTT_PASSWORD=doi-mat-khau-backend
# MQTT_ENABLED=true
# SERVER_PORT=8080
