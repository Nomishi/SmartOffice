# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit .env
POSTGRES_DB=smartoffice
POSTGRES_USER=smartoffice
POSTGRES_PASSWORD=smartoffice

# Backend chạy trên host (mvn spring-boot:run)
# Nếu chạy backend trong Docker: DB_URL=jdbc:postgresql://postgres:5432/smartoffice
# và MQTT_BROKER_URL=tcp://mosquitto:1883
DB_URL=jdbc:postgresql://localhost:5433/smartoffice
DB_USER=smartoffice
DB_PASSWORD=smartoffice

# MQTT
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=smartoffice-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# Server / CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth (P0 — sẽ dùng khi JWT được triển khai; hiện chưa đọc các biến này)
# JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# JWT_EXPIRES_IN_SECONDS=3600
# SEED_ADMIN_PASSWORD=doi-mat-khau-dev
