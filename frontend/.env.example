# true  = chạy bằng dữ liệu giả trong trình duyệt (không cần backend)
# false = gọi backend thật qua /api
VITE_USE_MOCK=true

# Địa chỉ backend khi chạy `npm run dev` với VITE_USE_MOCK=false
VITE_API_PROXY=http://localhost:8080

# Endpoint realtime (SSE) - chốt với M3. Mặc định /api/stream
# VITE_REALTIME_URL=/api/stream
