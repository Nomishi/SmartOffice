# Sao chép thành .env rồi đổi hết mật khẩu. KHÔNG commit file .env (đã có trong .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=doi-mat-khau-db

# --- Mosquitto: tài khoản MQTT, dạng user:mật_khẩu, ngăn cách bằng dấu phẩy ---
# - `backend` là tài khoản của Spring Boot (M3).
# - Mỗi thiết bị có tài khoản riêng, username = deviceId (Contract mục 3 và 11).
# - Mật khẩu KHÔNG được chứa dấu phẩy, dấu cách hoặc ký tự $.
# Thêm thiết bị: nối thêm ",office-env-02:mat-khau-moi" rồi `docker compose up -d --force-recreate mosquitto`.
# Thu hồi thiết bị (LOCKED/DECOMMISSIONED): xóa mục của thiết bị đó rồi chạy lại lệnh trên.
MQTT_USERS=backend:doi-mat-khau-backend,office-env-01:doi-mat-khau-env01,office-ctrl-01:doi-mat-khau-ctrl01

# --- Backend Spring Boot (M3) ---
# Mật khẩu MQTT của backend: PHẢI trùng mật khẩu của mục `backend` trong MQTT_USERS ở trên
# (cũng không được chứa dấu phẩy, dấu cách hay ký tự $).
BACKEND_MQTT_PASSWORD=doi-mat-khau-backend
# Chuỗi ngẫu nhiên từ 32 ký tự trở lên, ví dụ: openssl rand -base64 48
JWT_SECRET=doi-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# true: tạo sẵn admin/operator1/viewer1 với mật khẩu bên dưới (chỉ dùng khi dev, đổi mật khẩu trước khi triển khai thật)
SEED_DEV_USERS=true
ADMIN_PASSWORD=adminPassword123!
OPERATOR_PASSWORD=operatorPassword123!
VIEWER_PASSWORD=viewerPassword123!
# Đường dẫn mã nguồn (mặc định khi các thư mục nằm cạnh nhau)
# BACKEND_DIR=../backend
# FRONTEND_DIR=../iot-frontend

# --- Giao diện web (profile `ui`) ---
# true: chạy bằng dữ liệu giả (không cần backend); false (mặc định): gọi backend thật qua /api
# FRONTEND_USE_MOCK=false
